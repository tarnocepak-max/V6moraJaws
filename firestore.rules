rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['rayhanafirzanx@gmail.com', 'tarnocepak@gmail.com', 'nurhestafauladhea@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // System Health / Connection Ping
    match /system_health/{healthId} {
      allow get: if isValidId(healthId);
      allow list: if true;
      allow write: if isValidId(healthId);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    // Work Orders / Tickets Collection
    match /tickets/{ticketId} {
      allow get: if isValidId(ticketId);
      allow list: if true;
      allow create: if isValidId(ticketId);
      allow update: if isValidId(ticketId);
      allow delete: if isValidId(ticketId);
    }

    // Contractors & Basecamps Collection
    match /contractors/{contractorId} {
      allow get: if isValidId(contractorId);
      allow list: if true;
      allow create, update, delete: if isValidId(contractorId);
    }

    // Coverage Areas Collection
    match /coverage_areas/{areaId} {
      allow get: if isValidId(areaId);
      allow list: if true;
      allow create, update, delete: if isValidId(areaId);
    }

    // Work Order Real-Time Messages (Live Chat)
    match /ticket_messages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if true;
      allow create, update: if isValidId(messageId);
      allow delete: if isValidId(messageId);
    }

    // Audit Logs Collection (Append-Only)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // System Error Logs Collection (Append-Only)
    match /system_error_logs/{errorId} {
      allow get: if isValidId(errorId);
      allow list: if true;
      allow create: if isValidId(errorId);
      allow update, delete: if false;
    }

    // WhatsApp Message Templates
    match /wa_templates/{templateId} {
      allow get: if isValidId(templateId);
      allow list: if true;
      allow create, update, delete: if isValidId(templateId);
    }

    // Global Application Settings (Persistent App Configuration)
    match /appSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Report Dropdown Categories (Report Status, Reason Report, Rootcause)
    match /report_dropdown_categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // User Preferences (User-Scoped Settings)
    match /users/{userId}/preferences/{prefId} {
      allow get, list: if isValidId(userId) && isValidId(prefId);
      allow create, update, delete: if isValidId(userId) && isValidId(prefId);
    }
  }
}

